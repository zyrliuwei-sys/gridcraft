{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-lobby-ai",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://hotel-lobby.org",
    "VITE_APP_NAME": "Hotel Lobby AI",
    "VITE_APP_DESCRIPTION": "Plan a two-person Hotel Lobby AI filter video and copy a prompt for an image-to-video studio.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gridcraft",
      "database_id": "3ed52391-be84-4632-a0eb-9c0a854b7c85",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "routes": [{ "pattern": "hotel-lobby.org", "custom_domain": true }]
}
